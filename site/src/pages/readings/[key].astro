---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { readBib, licenseLabel, KIND_LABELS } from '../../lib/course.mjs';

export async function getStaticPaths() {
  const readings = await getCollection('readings');
  return readings.map((r) => ({ params: { key: r.data.key }, props: { reading: r.data } }));
}

const { reading } = Astro.props;
const guide = await getEntry('guides', reading.key);
const rendered = guide ? await render(guide) : null;
const Content = rendered?.Content;
const bib = readBib()[reading.key];

const isArxiv = reading.kind === 'arxiv';
const absUrl = isArxiv ? `https://arxiv.org/abs/${reading.source}` : reading.source;
const pdfUrl = isArxiv ? `https://arxiv.org/pdf/${reading.source}` : null;
const embed = isArxiv && reading.license.startsWith('CC-BY');

const headings = [
  ...(rendered?.headings ?? []),
  ...(embed ? [{ depth: 2, slug: 'paper', text: 'Paper' }] : []),
  ...(bib ? [{ depth: 2, slug: 'bibtex', text: 'BibTeX' }] : []),
];
---

<StarlightPage frontmatter={{ title: `${reading.key}. ${reading.title}` }} headings={headings}>
  <p class="reading-meta">
    {reading.authors}{reading.year ? `, ${reading.year}` : ''}. {KIND_LABELS[reading.kind]}.
  </p>
  <ul>
    {
      isArxiv ? (
        <>
          <li>
            arXiv: <a href={absUrl}>{absUrl}</a>
          </li>
          <li>
            PDF: <a href={pdfUrl}>{pdfUrl}</a>
          </li>
        </>
      ) : (
        <li>
          Source: <a href={absUrl}>{absUrl}</a>
        </li>
      )
    }
    <li>License: {licenseLabel(reading.license)}</li>
    {
      reading.bibkey && (
        <li>
          BibTeX key: <code>{reading.bibkey}</code>
        </li>
      )
    }
  </ul>

  {Content && <Content />}

  {
    embed ? (
      <>
        <h2 id="paper">Paper</h2>
        <p>
          Shown from arXiv under its {licenseLabel(reading.license)} license. If the frame stays
          blank, open the <a href={pdfUrl}>PDF</a> directly.
        </p>
        <iframe class="paper-frame" src={pdfUrl} title={reading.title} loading="lazy" />
      </>
    ) : (
      <p>This site does not host copies of this reading; read it at the source link above.</p>
    )
  }

  {
    bib && (
      <>
        <h2 id="bibtex">BibTeX</h2>
        <pre><code>{bib}</code></pre>
      </>
    )
  }
</StarlightPage>

<style>
  .reading-meta {
    color: var(--sl-color-gray-2);
  }
  .paper-frame {
    width: 100%;
    height: 80vh;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-gray-6);
  }
</style>
