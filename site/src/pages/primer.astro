---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('overview', 'primer');
if (!entry) throw new Error('course/primer.md not found');
const { Content, headings } = await render(entry);
---

<StarlightPage frontmatter={{ title: 'Primer' }} headings={headings}>
  <Content />
</StarlightPage>
