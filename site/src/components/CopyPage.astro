---
// "Copy page" and "View as Markdown" for pages that have a Markdown version. The button copies the
// page's .md file to the clipboard; the link is the fallback and works without JavaScript.
interface Props {
  href: string;
}
const { href } = Astro.props;
---

<copy-page class="copy-page" data-src={href}>
  <button type="button" class="copy-page-button">
    <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
      stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="9" y="9" width="11" height="11" rx="2"></rect>
      <path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"></path>
    </svg>
    <span class="copy-page-label">Copy page</span>
  </button>
  <a class="copy-page-link" href={href}>View as Markdown</a>
  <span class="copy-page-status" role="status" aria-live="polite"></span>
</copy-page>
<noscript><style is:inline>.copy-page-button { display: none !important; }</style></noscript>

<script>
  const LABEL = 'Copy page';

  // A custom element, so it works on first load and on any page swapped in by view transitions.
  class CopyPage extends HTMLElement {
    timer?: number;
    busy = false;

    connectedCallback() {
      const button = this.querySelector('button');
      if (!button || button.dataset.bound) return;
      button.dataset.bound = '1';
      button.addEventListener('click', () => this.copy());
    }

    set(label: string, message: string, resetAfter: number) {
      const labelEl = this.querySelector('.copy-page-label');
      const status = this.querySelector('.copy-page-status');
      if (labelEl) labelEl.textContent = label;
      if (status) {
        // Clear first so the same message is announced again on a second copy.
        status.textContent = '';
        window.setTimeout(() => (status.textContent = message), 50);
      }
      window.clearTimeout(this.timer);
      this.timer = window.setTimeout(() => {
        if (labelEl) labelEl.textContent = LABEL;
      }, resetAfter);
    }

    async copy() {
      if (this.busy) return;
      this.busy = true;
      const src = this.dataset.src!;
      const text = fetch(src).then((r) => {
        if (!r.ok) throw new Error(`${r.status} for ${src}`);
        return r.text();
      });
      text.catch(() => {}); // handled below; avoids an unhandled rejection on the first path
      try {
        let done = false;
        // Passing a promise to ClipboardItem keeps the write inside the click, which Safari needs.
        if (window.ClipboardItem && navigator.clipboard?.write) {
          try {
            const blob = text.then((t) => new Blob([t], { type: 'text/plain' }));
            await navigator.clipboard.write([new ClipboardItem({ 'text/plain': blob })]);
            done = true;
          } catch {
            // Fall back to writeText below.
          }
        }
        if (!done) await navigator.clipboard.writeText(await text);
        this.set('Copied', 'Page copied as Markdown', 2000);
      } catch {
        this.set('Copy failed', 'Copy failed. Use the View as Markdown link instead.', 4000);
      } finally {
        this.busy = false;
      }
    }
  }

  if (!customElements.get('copy-page')) customElements.define('copy-page', CopyPage);
</script>

<style>
  .copy-page {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1rem;
    margin-top: 0.75rem;
    font-size: var(--sl-text-sm);
    line-height: 1.25;
  }
  .copy-page-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    /* Wide enough for "Copy failed", so the label change never moves anything. */
    min-width: 8.5rem;
    min-height: 2rem;
    margin: 0;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background: transparent;
    color: var(--sl-color-gray-2);
    font: inherit;
    cursor: pointer;
  }
  .copy-page-button:hover {
    border-color: var(--sl-color-gray-3);
    color: var(--sl-color-white);
  }
  /* Until the script defines the element, keep the button's space but hide it. */
  copy-page:not(:defined) .copy-page-button {
    visibility: hidden;
  }
  .copy-page-link {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    color: var(--sl-color-text-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .copy-page-link:hover {
    color: var(--sl-color-white);
  }
  .copy-page-button:focus-visible,
  .copy-page-link:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
  .copy-page-status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 50rem), (pointer: coarse) {
    .copy-page-button,
    .copy-page-link {
      min-height: 44px;
    }
  }
</style>
