{
  "name": "Agent Harness 101",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "24" }
  },
  "postCreateCommand": "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt && npm install -g @anthropic-ai/claude-code",
  "forwardPorts": [8787, 4321],
  "portsAttributes": {
    "8787": { "label": "lab server" },
    "4321": { "label": "site" }
  },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
